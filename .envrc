layout uv

# mcp-health-check-enrichment Phase 1.4 (REQ-HC-002): per-repo override of
# the mcp-common ``HEALTH_FEED_HALFLIFE_SECONDS`` default. The mcp-common
# default is 300s; oneiric overrides to 60s so fresh servers recover from
# WARMING_UP quickly without 503-flickering k8s probes. The /health route
# reads this at request time; the helper in ``oneiric/mcp/server.py``
# defaults to 60 if the env var is missing or unparseable.
export HEALTH_FEED_HALFLIFE_SECONDS=60
